# StudentHub - Root Security & Routing Configuration
# Course: AIUE203 - Web Development Fundamentals
# Author: Anshika Badala (25AIML002)

# Prevent directory indexing
Options -Indexes

# Block sensitive files from web access
<FilesMatch "(^\.env|\.sql$|\.log$|\.md$|composer\.|package\.)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to internal application directories if document root is set to project root
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Route root assets requests to public/assets/
    RewriteRule ^assets/(.*)$ public/assets/$1 [L,NC]

    # Route root pages requests to public/pages/
    RewriteRule ^pages/(.*)$ public/pages/$1 [L,NC]

    # Deny web access to internal backend directories
    RewriteRule ^(app|database|storage|tests)/ - [F,L,NC]
</IfModule>
